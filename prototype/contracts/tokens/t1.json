{
  "$schema": "https://design-tokens.github.io/community-group/format/v1.0.0/schema.json",
  "$description": "Machine-compiled from spec-prototype 5-dial state machine.",
  "color": {
    "primary": {
      "$value": "#00f0ff",
      "$type": "color",
      "$description": "Primary action and key interactive state"
    },
    "primary-hover": {
      "$value": "#38bdf8",
      "$type": "color",
      "$description": "Hover state of primary"
    },
    "surface": {
      "$value": "#111622",
      "$type": "color",
      "$description": "Card, panel, and workbench base surface"
    },
    "surface-raised": {
      "$value": "#182030",
      "$type": "color",
      "$description": "Elevated modal, sheet, or popover"
    },
    "surface-overlay": {
      "$value": "#1f293d",
      "$type": "color",
      "$description": "Top-tier fly-by-wire controls and overlay"
    },
    "border": {
      "$value": "#28334a",
      "$type": "color",
      "$description": "Default component boundary"
    },
    "border-strong": {
      "$value": "#3b4b6e",
      "$type": "color",
      "$description": "Active or emphasized component boundary"
    },
    "border-dim": {
      "$value": "#1e2638",
      "$type": "color",
      "$description": "Subtle hairline divider"
    },
    "text-primary": {
      "$value": "#e6edf3",
      "$type": "color",
      "$description": "Primary high-contrast typography"
    },
    "text-secondary": {
      "$value": "#8b949e",
      "$type": "color",
      "$description": "Supplementary metadata and labels"
    },
    "text-tertiary": {
      "$value": "#484f58",
      "$type": "color",
      "$description": "De-emphasized or disabled controls and copy"
    },
    "status-running": {
      "$value": "#22c55e",
      "$type": "color",
      "$description": "Nominal operational state"
    },
    "status-warning": {
      "$value": "#eab308",
      "$type": "color",
      "$description": "Warning state or capacity threshold"
    },
    "status-danger": {
      "$value": "#ef4444",
      "$type": "color",
      "$description": "Critical failure or thermal alert"
    },
    "bg-void": {
      "$value": "#05070a",
      "$type": "color",
      "$description": "Deepest atmospheric background"
    },
    "bg-base": {
      "$value": "#0a0d14",
      "$type": "color",
      "$description": "App foundation background chassis"
    }
  },
  "spacing": {
    "1": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Spacing unit 1"
    },
    "2": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Spacing unit 2"
    },
    "3": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Spacing unit 3"
    },
    "4": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Spacing unit 4"
    },
    "5": {
      "$value": "20px",
      "$type": "dimension",
      "$description": "Spacing unit 5"
    },
    "6": {
      "$value": "24px",
      "$type": "dimension",
      "$description": "Spacing unit 6"
    },
    "8": {
      "$value": "32px",
      "$type": "dimension",
      "$description": "Spacing unit 8"
    }
  },
  "radius": {
    "outer": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "Outer container boundary"
    },
    "inner": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Concentric inner child boundary"
    },
    "card": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "Card entity radius"
    },
    "btn": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Interactive control radius"
    },
    "pill": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Status badge pill radius"
    }
  },
  "typography": {
    "font-sans": {
      "$value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "$type": "fontFamily",
      "$description": "Primary UI font family"
    },
    "font-mono": {
      "$value": "\"SF Mono\", \"Fira Code\", \"Roboto Mono\", Menlo, monospace",
      "$type": "fontFamily",
      "$description": "Telemetry and code font family"
    }
  }
}