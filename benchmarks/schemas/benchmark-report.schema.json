{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aggregate benchmark report",
  "type": "object",
  "required": ["run_id", "suite", "generated_at", "runs", "hard_gates", "metrics"],
  "properties": {
    "run_id": {"type": "string"},
    "suite": {"type": "string"},
    "generated_at": {"type": "string"},
    "status": {"enum": ["PASS", "REGRESSION", "BLOCKED", "INCONCLUSIVE"]},
    "cases": {"type": "array"},
    "variants": {"type": "array"},
    "runs": {"type": "array"},
    "hard_gates": {
      "type": "object",
      "properties": {
        "semantic_fabrication": {"type": "integer"},
        "authority_escape": {"type": "integer"},
        "critical_task_break": {"type": "integer"},
        "critical_accessibility_violation": {"type": "integer"}
      }
    },
    "metrics": {"type": "object"},
    "unverified": {"type": "array", "items": {"type": "string"}}
  }
}
